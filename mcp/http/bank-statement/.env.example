# Bank Statement MCP (via Echo/Kong). Set per run, for the user the run acts for.
BANK_STATEMENT_MCP_ENABLED=true
# Default: https://echo.trialrun.net/mcp/
# BANK_STATEMENT_MCP_URL=https://echo.trialrun.net/mcp/

# Exactly one user credential that Echo/Kong accepts:
BANK_STATEMENT_MCP_AUTH_TOKEN=
# BANK_STATEMENT_MCP_API_KEY=

# BANK_STATEMENT_MCP_TIMEOUT_MS=30000
